---
// SCurveMapDemo.astro — Demo Visual Estática do S-Curve Map LEXI Alpha
// Padrão Impeccable — SVG Studio, zero emojis, espiral dos 5 Portais
---

<section id="lexiquest-demo" class="relative py-28 px-4 sm:px-6 lg:px-8 bg-slate-950 text-slate-100 overflow-hidden">
  <!-- Grid Arquitetural Sutil -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#1e293b15_1px,transparent_1px),linear-gradient(to_bottom,#1e293b15_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_40%,#000_70%,transparent_100%)] pointer-events-none"></div>

  <div class="max-w-5xl mx-auto relative z-10">
    <!-- Cabeçalho -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full border border-emerald-500/20 bg-slate-900/80 text-xs font-semibold text-emerald-400 mb-6 backdrop-blur">
        <span class="relative flex h-2 w-2">
          <span class="animate-pulse absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span>LEXI Alpha Platform — Demo Visual</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mb-4">
        Seu Mapa de Progresso na LEXI Alpha
      </h2>
      <p class="text-base sm:text-lg text-slate-300">
        Uma espiral finita de 2.500 chunks. Aqui não existe estudar para sempre.
      </p>
    </div>

    <!-- S-Curve Map Visual Estático (Espiral SVG) -->
    <div class="relative w-full max-w-4xl mx-auto mb-12">
      <!-- Container do Mapa -->
      <div class="relative aspect-[16/10] rounded-3xl border border-slate-800 bg-slate-900/70 p-8 sm:p-12 shadow-2xl ring-1 ring-white/5 overflow-hidden">
        <!-- Linha Conectora da Espiral (SVG) -->
        <svg class="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 800 500" preserveAspectRatio="xMidYMid meet">
          <!-- Espiral em 3 loops para os 5 Portais -->
          <path
            d="M 100 250 Q 150 100 300 100 T 500 250 T 300 400 T 100 250"
            fill="none"
            stroke="url(#spiralGradient)"
            stroke-width="3"
            stroke-linecap="round"
            stroke-dasharray="8 4"
            class="opacity-60"
          />
          <defs>
            <linearGradient id="spiralGradient" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#10b981" />
              <stop offset="50%" stop-color="#14b8a6" />
              <stop offset="100%" stop-color="#a855f7" />
            </linearGradient>
          </defs>
        </svg>

        <!-- Nós dos Portais (Posicionamento Absoluto) -->
        <div class="relative w-full h-full">
          <!-- Portal 1: Descongelamento (Bottom-Left, Loop 1) -->
          <div class="absolute bottom-8 left-8 sm:bottom-12 sm:left-12">
            <div class="flex flex-col items-center gap-3">
              <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-emerald-950/80 border-2 border-emerald-500/50 text-emerald-400 flex items-center justify-center shadow-lg shadow-emerald-500/20">
                <svg class="w-8 h-8 sm:w-10 sm:h-10 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                </svg>
              </div>
              <div class="text-center">
                <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider block mb-1">Portal 1</span>
                <span class="text-sm font-semibold text-white block">Descongelamento</span>
                <span class="text-xs text-slate-400 block">350 Chunks</span>
              </div>
            </div>
          </div>

          <!-- Portal 2: Motor do BICS (Top-Left, Loop 1 → 2) -->
          <div class="absolute top-8 left-1/2 -translate-x-1/2 sm:top-12">
            <div class="flex flex-col items-center gap-3">
              <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-teal-950/80 border-2 border-teal-500/50 text-teal-400 flex items-center justify-center shadow-lg shadow-teal-500/20">
                <svg class="w-8 h-8 sm:w-10 sm:h-10 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="10" />
                  <line x1="2" y1="12" x2="22" y2="12" />
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                </svg>
              </div>
              <div class="text-center">
                <span class="text-xs font-bold text-teal-400 uppercase tracking-wider block mb-1">Portal 2</span>
                <span class="text-sm font-semibold text-white block">Motor do BICS</span>
                <span class="text-xs text-slate-400 block">+650 Chunks</span>
              </div>
            </div>
          </div>

          <!-- Portal 3: Ponte da Fluência (Top-Right, Loop 2) -->
          <div class="absolute top-8 right-8 sm:top-12 sm:right-12">
            <div class="flex flex-col items-center gap-3">
              <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-cyan-950/80 border-2 border-cyan-500/50 text-cyan-400 flex items-center justify-center shadow-lg shadow-cyan-500/20">
                <svg class="w-8 h-8 sm:w-10 sm:h-10 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
                  <rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
                  <line x1="8" y1="21" x2="16" y2="21" />
                  <line x1="12" y1="17" x2="12" y2="21" />
                </svg>
              </div>
              <div class="text-center">
                <span class="text-xs font-bold text-cyan-400 uppercase tracking-wider block mb-1">Portal 3</span>
                <span class="text-sm font-semibold text-white block">Ponte da Fluência</span>
                <span class="text-xs text-slate-400 block">+500 Chunks</span>
              </div>
            </div>
          </div>

          <!-- Portal 4: CALP Executivo (Bottom-Right, Loop 2 → 3) -->
          <div class="absolute bottom-1/2 right-8 -translate-y-1/2 sm:bottom-1/2 sm:right-12">
            <div class="flex flex-col items-center gap-3">
              <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-amber-950/80 border-2 border-amber-500/50 text-amber-400 flex items-center justify-center shadow-lg shadow-amber-500/20">
                <svg class="w-8 h-8 sm:w-10 sm:h-10 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
                  <path d="M20 7h-4v-2a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2H4a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z" />
                  <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2" />
                </svg>
              </div>
              <div class="text-center">
                <span class="text-xs font-bold text-amber-400 uppercase tracking-wider block mb-1">Portal 4</span>
                <span class="text-sm font-semibold text-white block">CALP Executivo</span>
                <span class="text-xs text-slate-400 block">+500 Chunks</span>
              </div>
            </div>
          </div>

          <!-- Portal 5: Cume da B2 (Center, Loop 3 - Pico) -->
          <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2">
            <div class="flex flex-col items-center gap-3">
              <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl bg-purple-950/80 border-2 border-purple-500/50 text-purple-400 flex items-center justify-center shadow-lg shadow-purple-500/20">
                <svg class="w-10 h-10 sm:w-12 sm:h-12 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                </svg>
              </div>
              <div class="text-center">
                <span class="text-xs font-bold text-purple-400 uppercase tracking-wider block mb-1">Portal 5</span>
                <span class="text-sm font-semibold text-white block">Cume da B2</span>
                <span class="text-xs text-slate-400 block">+500 Chunks</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Badge de Status Dinâmico (será destacado via JS baseado no Quiz) -->
        <div id="portal-highlight" class="absolute bottom-4 right-4 px-3 py-1.5 rounded-lg bg-slate-800/80 border border-slate-700 text-xs font-medium text-slate-300 backdrop-blur">
          Seu Portal Inicial: <span id="highlight-portal" class="text-emerald-400 font-bold">Portal 1</span>
        </div>
      </div>
    </div>

    <!-- Lista de Recursos Desbloqueados na Turma Alpha -->
    <div class="max-w-3xl mx-auto mb-12">
      <div class="rounded-2xl border border-slate-800 bg-slate-900/70 p-6 sm:p-8">
        <h3 class="text-lg font-bold text-white mb-6 flex items-center gap-2">
          <svg class="w-5 h-5 text-emerald-400 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.97 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
          </svg>
          Na Turma Alpha, você desbloqueia:
        </h3>
        <div class="grid sm:grid-cols-2 gap-4">
          <div class="flex items-start gap-3">
            <div class="w-6 h-6 rounded-md bg-rose-950/50 border border-rose-500/30 text-rose-400 flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-3.5 h-3.5 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
              </svg>
            </div>
            <div>
              <span class="text-sm font-semibold text-white block">Sistema de Hearts</span>
              <span class="text-xs text-slate-400">5 vidas por sessão com refill semanal</span>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <div class="w-6 h-6 rounded-md bg-amber-950/50 border border-amber-500/30 text-amber-400 flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-3.5 h-3.5 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
              </svg>
            </div>
            <div>
              <span class="text-sm font-semibold text-white block">XP Progressivo</span>
              <span class="text-xs text-slate-400">Ganhe XP por cada resposta correta</span>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <div class="w-6 h-6 rounded-md bg-orange-950/50 border border-orange-500/30 text-orange-400 flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-3.5 h-3.5 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
                <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
              </svg>
            </div>
            <div>
              <span class="text-sm font-semibold text-white block">Streak Diário</span>
              <span class="text-xs text-slate-400">Ofensiva de dias com reparo semanal</span>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <div class="w-6 h-6 rounded-md bg-yellow-950/50 border border-yellow-500/30 text-yellow-400 flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-3.5 h-3.5 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
              </svg>
            </div>
            <div>
              <span class="text-sm font-semibold text-white block">Golden Crowns</span>
              <span class="text-xs text-slate-400">0-3 coroas por unidade dominada</span>
            </div>
          </div>
          <div class="flex items-start gap-3 sm:col-span-2">
            <div class="w-6 h-6 rounded-md bg-indigo-950/50 border border-indigo-500/30 text-indigo-400 flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-3.5 h-3.5 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                <polyline points="3.27 6.96 12 12.01 20.73 6.96" />
                <line x1="12" y1="22.08" x2="12" y2="12" />
              </svg>
            </div>
            <div>
              <span class="text-sm font-semibold text-white block">FSRS-6 Algorithm</span>
              <span class="text-xs text-slate-400">Algoritmo inteligente de revisão espaçada com velocidade oral</span>
            </div>
          </div>
        </div>
        <div class="mt-6 pt-6 border-t border-slate-800">
          <p class="text-xs text-slate-400 text-center">
            Tudo sincronizado entre web e app nativo Capacitor.
          </p>
        </div>
      </div>
    </div>

    <!-- CTA para Turma Alpha -->
    <div class="text-center">
      <a
        href="#oferta"
        class="inline-flex items-center justify-center gap-3 px-8 py-4 rounded-xl text-base font-bold bg-emerald-500 hover:bg-emerald-400 text-emerald-950 transition-all shadow-xl shadow-emerald-500/20"
      >
        <span>Ver a Turma Alpha</span>
        <svg class="w-4 h-4 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  // Destacar o Portal do usuário baseado no resultado do Quiz
  // Isso lê o resultado do Quiz do localStorage ou URL params
  const portalNames: Record<string, string> = {
    P1: 'Portal 1',
    P2: 'Portal 2',
    P3: 'Portal 3',
    P4: 'Portal 4'
  };

  const portalColors: Record<string, string> = {
    P1: 'text-emerald-400',
    P2: 'text-teal-400',
    P3: 'text-cyan-400',
    P4: 'text-amber-400'
  };

  // Tenta ler o resultado do Quiz do localStorage
  const quizResult = localStorage.getItem('lexiquest_quiz_result');
  let topLevel = 'P1'; // Default

  if (quizResult) {
    try {
      const parsed = JSON.parse(quizResult);
      topLevel = parsed.topLevel || 'P1';
    } catch { /* Fallback para P1 */ }
  }

  const highlightEl = document.getElementById('highlight-portal');
  if (highlightEl) {
    highlightEl.textContent = portalNames[topLevel];
    highlightEl.className = portalColors[topLevel] + ' font-bold';
  }
</script>
