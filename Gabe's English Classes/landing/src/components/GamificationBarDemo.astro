---
// GamificationBarDemo.astro — HUD de Demonstração do LEXI Alpha
// Padrão Impeccable — SVG Studio, zero emojis, HUD estilizado
---

<div class="relative w-full max-w-4xl mx-auto mb-8">
  <div class="rounded-2xl border border-slate-800 bg-slate-900/80 p-4 sm:p-6 shadow-xl ring-1 ring-white/5 backdrop-blur">
    <!-- Header do HUD -->
    <div class="flex items-center justify-between mb-4 pb-4 border-b border-slate-800">
      <div class="flex items-center gap-2">
        <div class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></div>
        <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider">Gamification HUD</span>
      </div>
      <div class="text-xs text-slate-400">
        <span class="hidden sm:inline">Demo Visual — Turma Alpha</span>
        <span class="sm:hidden">Demo — Turma Alpha</span>
      </div>
    </div>

    <!-- Grid de Métricas -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      <!-- Hearts -->
      <div class="flex flex-col items-center gap-2 p-3 rounded-xl bg-slate-950/50 border border-slate-800">
        <div class="flex items-center gap-1.5">
          <svg class="w-5 h-5 text-rose-400 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
          </svg>
          <span class="text-sm font-bold text-white">5/5</span>
        </div>
        <span class="text-xs text-slate-400">Hearts</span>
      </div>

      <!-- XP -->
      <div class="flex flex-col items-center gap-2 p-3 rounded-xl bg-slate-950/50 border border-slate-800">
        <div class="flex items-center gap-1.5">
          <svg class="w-5 h-5 text-amber-400 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
          </svg>
          <span class="text-sm font-bold text-white">450</span>
        </div>
        <span class="text-xs text-slate-400">XP</span>
      </div>

      <!-- Streak -->
      <div class="flex flex-col items-center gap-2 p-3 rounded-xl bg-slate-950/50 border border-slate-800">
        <div class="flex items-center gap-1.5">
          <svg class="w-5 h-5 text-orange-400 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
            <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
          </svg>
          <span class="text-sm font-bold text-white">14d</span>
        </div>
        <span class="text-xs text-slate-400">Streak</span>
      </div>

      <!-- Crowns -->
      <div class="flex flex-col items-center gap-2 p-3 rounded-xl bg-slate-950/50 border border-slate-800">
        <div class="flex items-center gap-1.5">
          <svg class="w-5 h-5 text-yellow-400 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
          </svg>
          <span class="text-sm font-bold text-white">12</span>
        </div>
        <span class="text-xs text-slate-400">Crowns</span>
      </div>
    </div>

    <!-- Tooltip Explicativo -->
    <div class="mt-4 pt-4 border-t border-slate-800">
      <p class="text-xs text-slate-400 text-center">
        Veja seu progresso em tempo real na Turma Alpha — sincronizado entre web e app nativo.
      </p>
    </div>
  </div>
</div>
