---
// LEXI Alpha Design System - Dark Cyber-Zen Theme
// Font: Inter (Google Fonts)
// Spacing: Base unit 8px
// Container: Max-width 1152px
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter', system-ui, sans-serif;
    --aw-font-serif: 'Inter', system-ui, sans-serif;
    --aw-font-heading: 'Inter', system-ui, sans-serif;

    /* LEXI Alpha Colors - Sentry-inspired adapted for education */
    --aw-color-primary: #0f172a;  /* slate-950 - background */
    --aw-color-secondary: #9333ea; /* purple-600 - brand */
    --aw-color-accent: #34d399;   /* emerald-400 - success/CTA */
    --aw-color-tertiary: #fbbf24; /* amber-400 - highlights */

    --aw-color-text-heading: #f8fafc;  /* slate-50 */
    --aw-color-text-default: #e2e8f0; /* slate-200 */
    --aw-color-text-muted: #94a3b8;    /* slate-400 */
    --aw-color-bg-page: #0f172a;      /* slate-950 */

    --aw-color-bg-page-dark: #0f172a; /* slate-950 */

    /* Spacing system - base unit 8px */
    --aw-spacing-unit: 8px;
    --aw-container-max-width: 1152px;

    ::selection {
      background-color: #34d399;
      color: #0f172a;
    }
  }

  .dark {
    --aw-font-sans: 'Inter', system-ui, sans-serif;
    --aw-font-serif: 'Inter', system-ui, sans-serif;
    --aw-font-heading: 'Inter', system-ui, sans-serif;

    --aw-color-primary: #0f172a;  /* slate-950 */
    --aw-color-secondary: #9333ea; /* purple-600 */
    --aw-color-accent: #34d399;   /* emerald-400 */
    --aw-color-tertiary: #fbbf24; /* amber-400 */

    --aw-color-text-heading: #f8fafc;  /* slate-50 */
    --aw-color-text-default: #e2e8f0; /* slate-200 */
    --aw-color-text-muted: #94a3b8;    /* slate-400 */
    --aw-color-bg-page: #0f172a;      /* slate-950 */

    ::selection {
      background-color: #34d399;
      color: #0f172a;
    }
  }
</style>
